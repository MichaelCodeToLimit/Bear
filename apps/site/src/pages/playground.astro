---
import BaseLayout from '../layouts/BaseLayout.astro'
import BearBuddy from '../islands/BearBuddy'
import TilePhysics from '../islands/TilePhysics'
import MiniDemos from '../islands/MiniDemos'
---

<BaseLayout title="Playground" description="Little toys built from the Bear brand. Poke them, drag them, break nothing.">
  <section class="pg" aria-labelledby="pg-title">
    <h1 id="pg-title">Playground</h1>
    <p class="pg__lead">A few toys to fiddle with. Everything here is optional and nothing is saved.</p>

    <div class="pg__grid">
      <article class="card pg__card" data-playground-card>
        <h2>Bear buddy</h2>
        <p>Say hello. The bear watches your pointer. Tap the button to change its mood.</p>
        <BearBuddy client:visible />
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Tile physics</h2>
        <p>Twelve app tiles, one box. Drag them about or hit Reset to drop them again.</p>
        <TilePhysics client:visible />
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Mini live demos</h2>
        <p>A tiny spreadsheet, a doodle pad and a checklist. Nothing is saved.</p>
        <MiniDemos client:visible />
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Theme mixer</h2>
        <p class="pg__soon">Coming up</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .pg__lead {
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }
  .pg__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .pg__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }
  .pg__card > p {
    margin: 0;
    color: var(--ink-muted);
  }
  .pg__soon {
    font-weight: 700;
    color: var(--accent);
  }

  /* Bear buddy */
  .buddy {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .buddy__svg {
    width: min(100%, 240px);
    height: auto;
    overflow: visible;
  }
  .buddy__lids,
  .buddy__zzz {
    opacity: 0;
  }
  .buddy[data-mood='sleep'] .buddy__lids,
  .buddy[data-mood='sleep'] .buddy__zzz {
    opacity: 1;
  }
  .buddy[data-mood='sleep'] .buddy__eyes {
    opacity: 0;
  }
  .buddy__arm {
    transform-box: fill-box;
    transform-origin: 50% 90%;
  }
  .buddy[data-mood='wave'] .buddy__arm {
    transform: rotate(-35deg);
    animation: buddy-wave calc(900ms * var(--motion-speed)) ease-in-out infinite alternate;
  }
  .buddy[data-mood='dance'] .buddy__body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: buddy-dance calc(600ms * var(--motion-speed)) var(--ease-bounce) infinite alternate;
  }
  .buddy[data-mood='sleep'] .buddy__head {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: buddy-snooze calc(2400ms * var(--motion-speed)) ease-in-out infinite alternate;
  }
  @keyframes buddy-wave {
    from {
      transform: rotate(-20deg);
    }
    to {
      transform: rotate(-55deg);
    }
  }
  @keyframes buddy-dance {
    from {
      transform: rotate(-4deg) translateY(0);
    }
    to {
      transform: rotate(4deg) translateY(-8px);
    }
  }
  @keyframes buddy-snooze {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(3px);
    }
  }

  /* Mini demos */
  .mini {
    position: relative;
    min-width: 0;
    display: grid;
    gap: 0.75rem;
  }
  .mini__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .mini__tab {
    font: inherit;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--surface-edge);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .mini__tab[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .mini__tab:focus-visible,
  .doodle__swatch:focus-visible,
  .msheet__input:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .mini__panel {
    min-width: 0;
  }
  .msheet__hint {
    margin: 0 0 0.5rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .msheet__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .msheet__cell {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .msheet__input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    font: inherit;
    padding: 0.4rem 0.5rem;
    border-radius: var(--r-md);
    border: 1px solid var(--surface-edge);
    background: var(--surface);
    color: var(--ink);
  }
  .msheet__result {
    min-height: 1.3em;
    padding: 0 0.5rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .msheet__result[data-error] {
    color: var(--accent);
  }
  .doodle {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .doodle__canvas {
    display: block;
    width: 100%;
    touch-action: none;
    cursor: crosshair;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--bg-to) 55%, var(--surface));
    border: 1px solid var(--surface-edge);
  }
  .doodle__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .doodle__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .doodle__swatch {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid var(--surface);
    box-shadow: 0 0 0 1px var(--surface-edge);
    cursor: pointer;
    padding: 0;
  }
  .doodle__swatch[aria-pressed='true'] {
    box-shadow: 0 0 0 3px var(--ink);
  }
  .tasks__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .tasks__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .tasks__item[data-done] span {
    text-decoration: line-through;
    color: var(--ink-muted);
  }
  .tasks__status {
    margin: 0.6rem 0 0;
    font-weight: 700;
  }
  .confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .confetti span {
    position: absolute;
    top: -8px;
    left: var(--x);
    width: 8px;
    height: 12px;
    border-radius: 2px;
    transform: rotate(var(--rot));
    animation: confetti-fall calc(1600ms * var(--motion-speed, 1)) ease-in var(--delay) forwards;
  }
  @keyframes confetti-fall {
    to {
      transform: translate(var(--dx), 260px) rotate(calc(var(--rot) + 540deg));
      opacity: 0;
    }
  }

  /* Tile physics */
  .tp {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    min-width: 0;
  }
  .tp__canvas {
    display: block;
    width: 100%;
    height: 300px;
    touch-action: none;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--bg-to) 55%, var(--surface));
    border: 1px solid var(--surface-edge);
    cursor: grab;
  }
  .tp__canvas:active {
    cursor: grabbing;
  }
  .tp__loading {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
