---
import BaseLayout from '../layouts/BaseLayout.astro'
import BearBuddy from '../islands/BearBuddy'
import TilePhysics from '../islands/TilePhysics'
---

<BaseLayout title="Playground" description="Little toys built from the Bear brand. Poke them, drag them, break nothing.">
  <section class="pg" aria-labelledby="pg-title">
    <h1 id="pg-title">Playground</h1>
    <p class="pg__lead">A few toys to fiddle with. Everything here is optional and nothing is saved.</p>

    <div class="pg__grid">
      <article class="card pg__card" data-playground-card>
        <h2>Bear buddy</h2>
        <p>Say hello. The bear watches your pointer. Tap the button to change its mood.</p>
        <BearBuddy client:visible />
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Tile physics</h2>
        <p>Twelve app tiles, one box. Drag them about or hit Reset to drop them again.</p>
        <TilePhysics client:visible />
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Mini live demos</h2>
        <p class="pg__soon">Coming up</p>
      </article>

      <article class="card pg__card" data-playground-card>
        <h2>Theme mixer</h2>
        <p class="pg__soon">Coming up</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .pg__lead {
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }
  .pg__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .pg__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }
  .pg__card > p {
    margin: 0;
    color: var(--ink-muted);
  }
  .pg__soon {
    font-weight: 700;
    color: var(--accent);
  }

  /* Bear buddy */
  .buddy {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }
  .buddy__svg {
    width: min(100%, 240px);
    height: auto;
    overflow: visible;
  }
  .buddy__lids,
  .buddy__zzz {
    opacity: 0;
  }
  .buddy[data-mood='sleep'] .buddy__lids,
  .buddy[data-mood='sleep'] .buddy__zzz {
    opacity: 1;
  }
  .buddy[data-mood='sleep'] .buddy__eyes {
    opacity: 0;
  }
  .buddy__arm {
    transform-box: fill-box;
    transform-origin: 50% 90%;
  }
  .buddy[data-mood='wave'] .buddy__arm {
    transform: rotate(-35deg);
    animation: buddy-wave calc(900ms * var(--motion-speed)) ease-in-out infinite alternate;
  }
  .buddy[data-mood='dance'] .buddy__body {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: buddy-dance calc(600ms * var(--motion-speed)) var(--ease-bounce) infinite alternate;
  }
  .buddy[data-mood='sleep'] .buddy__head {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: buddy-snooze calc(2400ms * var(--motion-speed)) ease-in-out infinite alternate;
  }
  @keyframes buddy-wave {
    from {
      transform: rotate(-20deg);
    }
    to {
      transform: rotate(-55deg);
    }
  }
  @keyframes buddy-dance {
    from {
      transform: rotate(-4deg) translateY(0);
    }
    to {
      transform: rotate(4deg) translateY(-8px);
    }
  }
  @keyframes buddy-snooze {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(3px);
    }
  }

  /* Tile physics */
  .tp {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    min-width: 0;
  }
  .tp__canvas {
    display: block;
    width: 100%;
    height: 300px;
    touch-action: none;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--bg-to) 55%, var(--surface));
    border: 1px solid var(--surface-edge);
    cursor: grab;
  }
  .tp__canvas:active {
    cursor: grabbing;
  }
  .tp__loading {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
