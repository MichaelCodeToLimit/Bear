---
import BaseLayout from '../layouts/BaseLayout.astro'
import AppPicker from '../islands/AppPicker'
import { tourApps } from '../lib/tour'

const apps = tourApps()
---

<BaseLayout title="Tour" description="Meet the Bear apps and watch each one work.">
  <section class="tour section" aria-labelledby="tour-title">
    <p class="eyebrow">The tour</p>
    <h1 id="tour-title" class="display tour__title">Pick an app. <span class="grad">Watch it work.</span></h1>
    <p class="tour__lead lede">Pick an app to see it in action. Nine are ready today, including Photo from Bear Studio, and four are on their way.</p>

    <!-- AppPicker wraps itself in IslandBoundary, so a render error is caught inside this one island. -->
    <AppPicker client:load apps={apps} />

    <ul class="tour-static" data-tour-static>
      {
        apps.map((app) => (
          <li class="card glass" id={`static-${app.id}`}>
            <h2>{app.name}</h2>
            <p>{app.tagline}{!app.ready && ' (Coming soon)'}</p>
            <ul>
              {app.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style is:global>
  .tour.section {
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .tour__title {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
  }
  .tour__lead {
    max-width: 38rem;
    margin-bottom: 2rem;
  }

  /* Without JavaScript the picker is inert, so show the plain list instead. */
  html.js .tour-static,
  html:not(.js) .picker {
    display: none;
  }
  .tour-static {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tour-static > li {
    padding: 1rem 1.25rem;
  }

  .picker {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.9rem;
  }
  .picker__tile {
    font: inherit;
    text-align: left;
    cursor: pointer;
    align-items: flex-start;
  }
  .picker__tile:hover,
  .picker__tile.is-open {
    border-color: var(--tile-color);
    box-shadow: var(--shadow-md), 0 0 28px -10px var(--tile-color);
  }
  .picker__tile:hover {
    transform: translateY(-3px);
  }
  .picker__tile.is-open {
    background: color-mix(in srgb, var(--tile-color) 10%, var(--glass));
  }

  /* Open panel: a large glass product window, matching the Home window's title bar. */
  .picker__panel {
    grid-column: 1 / -1;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    column-gap: 1.75rem;
    align-items: center;
    padding: 0 1.5rem 1.5rem;
    overflow: hidden;
    background: var(--glass);
    border: 1px solid var(--edge);
    border-radius: var(--r-lg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md), 0 0 80px -20px var(--glow);
  }
  .picker__bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 3rem;
    margin: 0 -1.5rem 1.25rem;
    padding: 0.5rem 3.4rem 0.5rem 1.5rem;
    border-bottom: 1px solid var(--edge);
    font-size: 0.85rem;
  }
  .picker__back {
    color: var(--ink);
    font-weight: 600;
  }
  .picker__tabs {
    display: flex;
    gap: 1rem;
    color: var(--ink-muted);
  }
  .picker__tabs .is-on {
    color: var(--ink);
    box-shadow: 0 2px 0 var(--accent);
  }
  /* The panel bar above already names the app and shows the tabs; hide the demo's duplicate bar. */
  .picker__panel .demo__bar {
    display: none;
  }
  .picker__stage {
    min-width: 0;
  }
  /* App colours are never text on dark; the name renders in the ink. */
  .picker__info h2 {
    color: var(--ink);
    margin-bottom: 0.2em;
  }
  .picker__tagline {
    margin: 0 0 0.6rem;
    color: var(--ink-muted);
  }
  .picker__features {
    margin: 0.75rem 0 1rem;
    padding-left: 1.2rem;
  }
  .picker__close {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .picker__close:hover {
    background: var(--edge);
    color: var(--ink);
  }

  /* Phones: the panel becomes a bottom sheet. */
  @media (max-width: 639px) {
    .picker {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .picker__panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.25rem;
      max-height: 78vh;
      overflow-y: auto;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      padding: 0 1.1rem 1.5rem;
      background: var(--surface);
    }
    .picker__bar {
      margin: 0 -1.1rem;
      padding-left: 1.1rem;
    }
    .picker__tabs {
      display: none;
    }
  }
</style>
