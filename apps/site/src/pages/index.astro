---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import ProductWindow from '../components/home/ProductWindow.astro'
import Marquee from '../components/home/Marquee.astro'
import HowItWorks from '../components/home/HowItWorks.astro'
import FeatureBento from '../components/home/FeatureBento.astro'
import SuiteDiagram from '../components/home/SuiteDiagram.astro'
import FinalCta from '../components/home/FinalCta.astro'
import { fetchLatestRelease } from '../lib/releases'

const release = await fetchLatestRelease()
---

<BaseLayout title="Bear">
  <Hero release={release} />
  <ProductWindow />
  <Marquee />
  <HowItWorks />
  <FeatureBento />
  <SuiteDiagram />
  <FinalCta release={release} />
</BaseLayout>
