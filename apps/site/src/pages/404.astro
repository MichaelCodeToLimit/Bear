---
import BaseLayout from '../layouts/BaseLayout.astro'
import Bear from '../components/Bear.astro'
import { url } from '../site.config'
---

<BaseLayout title="Page not found">
  <div class="lost section">
    <div class="lost__bear">
      <Bear size={120} mood="wave" />
    </div>
    <p class="eyebrow">Error 404</p>
    <h1 class="display lost__title">This bear is <span class="grad">lost.</span></h1>
    <p class="lede lost__lede">It wandered off the map looking for this page. Let's head back to the cabin.</p>
    <a class="btn btn--primary" href={url('')}>Back home</a>
  </div>
</BaseLayout>

<style>
  .lost {
    text-align: center;
  }
  .lost__bear {
    display: inline-block;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 28px var(--glow));
  }
  .lost__title {
    font-size: clamp(2.25rem, 7vw, 4.25rem);
  }
  .lost__lede {
    max-width: 30rem;
    margin: 0 auto 1.75rem;
  }
</style>
