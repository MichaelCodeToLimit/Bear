---
import BaseLayout from '../layouts/BaseLayout.astro'
import Bear from '../components/Bear.astro'
import PlatformCards from '../components/PlatformCards.astro'
import { SITE } from '../site.config'
import { fetchLatestRelease } from '../lib/releases'

const release = await fetchLatestRelease()

const date = release
  ? new Date(release.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
  : ''
const steps = [
  `git clone ${SITE.repoUrl}.git`,
  'cd Bear',
  'pnpm install',
  'pnpm dev'
]
---

<BaseLayout title="Download" description="Download Bear for Windows, macOS or Linux. Free and open source.">
  <section class="dl">
    <header class="dl-hero">
      <div class="dl-bear">
        {release ? (
          <div class="dl-carry" data-catch>
            <Bear size={96} mood="bob" />
            <span class="dl-box" aria-hidden="true"></span>
          </div>
        ) : (
          <Bear size={96} mood="nap" />
        )}
      </div>
      {release ? (
        <>
          <p class="eyebrow">Download</p>
          <h1 class="display dl-title">Get Bear. <span class="grad">Keep it.</span></h1>
          <p class="dl-version"><span class="pill">Bear {release.version} · {date}</span></p>
          <p><a href={release.notesUrl}>Release notes</a></p>
        </>
      ) : (
        <>
          <p class="eyebrow">Download</p>
          <h1 class="display dl-title">The first release <span class="grad">is on its way</span></h1>
          <p class="dl-lead lede">Bear is still packing its bags. In the meantime you can build it yourself, or watch the Releases page for the first installers.</p>
        </>
      )}
    </header>

    <PlatformCards release={release} />

    <section class="dl-source" aria-labelledby="dl-source-title">
      <h2 id="dl-source-title">Build from source</h2>
      <p>You need Node 20 or newer and pnpm.</p>
      <div class="terminal">
        <div class="terminal__bar"><span class="terminal__dots" aria-hidden="true"><span></span><span></span><span></span></span></div>
        <pre><code>{steps.join('\n')}</code></pre>
      </div>
      <p><a href={SITE.releasesUrl}>All releases on GitHub</a></p>
    </section>
  </section>
</BaseLayout>

<script>
  import { initYourDevice, initCatch } from '../scripts/detectOS'
  initYourDevice()
  initCatch()
</script>

<style is:global>
  .dl {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .dl-hero {
    text-align: center;
    margin-bottom: 2rem;
  }
  .dl .dl-title {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
  }
  .dl .dl-lead {
    margin-inline: auto;
  }
  .dl-version {
    color: var(--ink-muted);
  }
  .dl-carry {
    position: relative;
    display: inline-block;
  }
  .dl-box {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 52px;
    height: 34px;
    transform: translateX(-50%);
    background: #c89a62;
    border: 2px solid #8a5f33;
    border-radius: 4px;
  }
  .dl-box::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 8px;
    transform: translateX(-50%);
    background: #e9d3a8;
  }
  .dl-carry.is-catching {
    animation: dl-catch 0.5s var(--ease-bounce);
  }
  @keyframes dl-catch {
    30% {
      transform: translateY(-14px) rotate(-4deg);
    }
    60% {
      transform: translateY(2px);
    }
  }
  [data-motion='off'] .dl-carry.is-catching {
    animation: none;
  }
  .dl-source h2 {
    font-size: 1.3rem;
  }
</style>
