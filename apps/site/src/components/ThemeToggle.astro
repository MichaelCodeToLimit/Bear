<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
  <svg class="theme-toggle__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path class="theme-toggle__moon" fill="currentColor" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
    <g class="theme-toggle__sun" fill="currentColor">
      <circle cx="12" cy="12" r="4.5" />
      <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
    </g>
  </svg>
  <!-- CSS picks the label from html[data-theme], which the head script sets before paint. The label names the theme the button switches to. -->
  <span class="theme-toggle__to-light">Light theme</span>
  <span class="theme-toggle__to-dark">Dark theme</span>
</button>

<style is:global>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: var(--glass);
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .theme-toggle__to-dark,
  .theme-toggle__sun {
    display: none;
  }
  html[data-theme='light'] .theme-toggle__to-light,
  html[data-theme='light'] .theme-toggle__moon {
    display: none;
  }
  html[data-theme='light'] .theme-toggle__to-dark {
    display: inline;
  }
  html[data-theme='light'] .theme-toggle__sun {
    display: inline;
  }
</style>

<script>
  import { bindThemeToggles } from '../scripts/themeToggle'
  bindThemeToggles()
</script>
