---
import { SITE, url } from '../site.config'
import { formatSize, windowsDownloads, type ReleaseInfo } from '../lib/releases'

interface Props {
  release: ReleaseInfo | null
}
const { release } = Astro.props
const { exe, msi, version } = windowsDownloads(release)
---

<div class="windl">
  <div class="windl__row">
    {exe ? (
      <a class="btn btn--primary windl__main" href={exe.url} data-windows-download="exe">
        <span class="windl__title">Download for Windows</span>
        <span class="windl__sub">Bear {version} · .exe · {formatSize(exe.size)}</span>
      </a>
    ) : (
      <a class="btn btn--primary windl__main" href={SITE.releasesUrl} data-windows-download="releases">
        <span class="windl__title">Download for Windows</span>
      </a>
    )}
    {msi && (
      <a class="btn btn--ghost windl__msi" href={msi.url} data-windows-download="msi">.msi for IT / whole computer</a>
    )}
  </div>
  {!exe && <p class="windl__note">First release coming soon</p>}
  <a class="windl__other" href={url('download/')}>Other systems →</a>
</div>

<style>
  .windl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .windl__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .windl__main {
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.8rem 1.8rem;
    font-size: 1.1rem;
  }
  .windl__title {
    font-weight: 700;
  }
  .windl__sub {
    font-size: 0.8rem;
    font-weight: 500;
  }
  .windl__msi {
    align-self: center;
  }
  .windl__note {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .windl__other {
    color: var(--ink-muted);
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .windl__other:hover {
    color: var(--ink);
  }
</style>
