---
import OsGlyph from './OsGlyph.astro'
import PlatformButton from './PlatformButton.astro'
import { platformCards, type DownloadFile, type ReleaseInfo } from '../lib/releases'

interface Props {
  release: ReleaseInfo | null
}
const { release } = Astro.props
const cards = platformCards(release)
const pending = release === null
const version = release?.version ?? null
const osName: Record<string, string> = { windows: 'Windows', mac: 'macOS', linux: 'Linux' }

// Real file names when the release has them, otherwise the pattern electron-builder will produce.
const v = version ?? '<version>'
const linux = cards[2]
const nameOf = (id: string, fallback: string): string => linux.slots.find((s) => s.id === id)?.file?.name ?? fallback
const rpmFile = linux.other.find((f) => f.kind === 'rpm')
const hints = [
  `sudo apt install ./${nameOf('deb', `bear_${v}_amd64.deb`)}`,
  `chmod +x ${nameOf('appimage', `Bear-${v}-x64.AppImage`)} && ./${nameOf('appimage', `Bear-${v}-x64.AppImage`)}`,
  `flatpak install --user ./${nameOf('flatpak', `Bear-${v}-x64.flatpak`)}`,
  `sudo dnf install ./${rpmFile?.name ?? `Bear-${v}-x64.rpm`}`
]
const otherItems = [
  { label: '.rpm (Fedora, openSUSE)', file: linux.other.find((f) => f.kind === 'rpm') ?? null },
  { label: '.tar.gz (any distro)', file: linux.other.find((f) => f.kind === 'targz') ?? null }
]
const zipLabel = (f: DownloadFile) => (f.arch === 'arm64' ? 'Apple silicon .zip' : 'Intel .zip')
---

<section class="pc" aria-label="Download Bear">
  <div class="pc-grid">
    {
      cards.map((card) => {
        const sums = card.slots.filter((s) => s.file?.sha256)
        return (
          <article class="glass pc-card" data-os-group={card.os} aria-labelledby={`pc-${card.os}`}>
            <div class="pc-top">
              <span class="pc-tile" aria-hidden="true">
                <OsGlyph os={card.os} size={26} />
              </span>
              <div class="pc-flags">
                <span class="pc-badge" data-your-device hidden>
                  Your device
                </span>
                <span class="pill pc-status" data-status={card.available ? 'available' : 'soon'}>
                  <span class="pc-dot" aria-hidden="true" />
                  {card.available ? 'Available' : 'Coming soon'}
                </span>
              </div>
            </div>

            <h2 class="pc-name" id={`pc-${card.os}`}>{card.title}</h2>
            <p class="pc-desc">{card.description}</p>

            <div class="pc-actions">
              {card.slots.map((s, i) => (
                <PlatformButton
                  label={s.label}
                  osName={osName[card.os]}
                  file={s.file}
                  pending={pending}
                  version={version}
                  primary={card.os === 'mac' || i === 0}
                />
              ))}
            </div>

            {card.os === 'linux' && (
              <details class="pc-more">
                <summary class="btn btn--ghost pc-more__summary">
                  Other <span aria-hidden="true">▾</span>
                </summary>
                <ul class="pc-more__list">
                  {otherItems.map((o) => (
                    <li>
                      <PlatformButton label={o.label} osName="Linux" file={o.file} pending={pending} version={version} link />
                    </li>
                  ))}
                </ul>
              </details>
            )}

            {card.os === 'mac' && card.extras.length > 0 && (
              <p class="pc-zips">
                Or a zip:{' '}
                {card.extras.map((f, i) => (
                  <>
                    {i > 0 && ', '}
                    <PlatformButton label={zipLabel(f)} osName="macOS" file={f} pending={false} version={version} link />
                  </>
                ))}
              </p>
            )}
            {card.os === 'mac' && (
              <p class="pc-help">Not sure which? Apple menu → About This Mac shows Chip (Apple silicon) or Processor (Intel).</p>
            )}

            {card.meta && <p class="pc-meta">{card.meta}</p>}
            {pending && <p class="pc-note">First release coming soon</p>}

            {sums.length > 0 && (
              <div class="pc-sha">
                {sums.map((s) => (
                  <div class="pc-sha__row">
                    <span class="pc-sha__label">SHA-256 · {s.file!.name}</span>
                    <code class="pc-sha__hash">{s.file!.sha256}</code>
                  </div>
                ))}
              </div>
            )}

            {card.os === 'linux' && (
              <ul class="pc-cmds" aria-label="Install commands">
                {hints.map((h) => (
                  <li>
                    <code>{h}</code>
                  </li>
                ))}
              </ul>
            )}

            <p class="pc-foot">
              {card.os === 'windows' && 'Not code-signed yet. If SmartScreen warns you, choose More info → Run anyway.'}
              {card.os === 'mac' && 'Not notarized yet. The first time, open System Settings → Privacy & Security and choose Open Anyway.'}
              {card.os === 'linux' && 'Run the command for the file you downloaded. AppImage needs no install.'}
            </p>
          </article>
        )
      })
    }
  </div>
</section>

<style is:global>
  .pc {
    margin: 0 0 2.5rem;
  }
  .pc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .pc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pc-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.4rem;
    text-align: left;
  }
  .pc-card[data-yours] {
    border-color: var(--accent);
    box-shadow:
      0 0 0 1px var(--accent),
      0 0 36px var(--glow);
    animation: pc-glow 3.2s ease-in-out infinite;
  }
  .pc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pc-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border: 1px solid var(--edge);
    border-radius: var(--r-md);
    background: var(--glass);
    color: var(--accent);
  }
  .pc-flags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.4rem;
  }
  .pc-status {
    color: var(--ink);
    white-space: nowrap;
  }
  .pc-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
  }
  .pc-status[data-status='soon'] .pc-dot {
    background: #f59e0b;
  }
  .pc-status[data-status='available'] .pc-dot {
    animation: pc-pulse 2.4s ease-in-out infinite;
  }
  .pc-badge {
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-pill);
    background: #1d4ed8;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .pc-badge[hidden] {
    display: none;
  }
  .pc-name {
    margin: 0.25rem 0 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .pc-desc {
    margin: 0;
    color: var(--ink-muted);
    line-height: 1.55;
  }
  .pc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.6rem;
  }
  .pc-actions > * {
    flex: 1 1 auto;
    text-align: center;
  }
  .pc-card .btn {
    min-width: 0;
    white-space: nowrap;
  }
  .pc-off {
    border-style: dashed;
    color: var(--ink-muted);
    cursor: not-allowed;
  }
  .pc-off:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--edge);
  }
  .pc-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pc-link.pc-off {
    text-decoration: line-through;
    color: var(--ink-muted);
  }
  .pc-more__summary {
    list-style: none;
    cursor: pointer;
    width: 100%;
  }
  .pc-more__summary::-webkit-details-marker {
    display: none;
  }
  .pc-more__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0.6rem 0 0;
    padding: 0 0.25rem;
    list-style: none;
  }
  .pc-zips,
  .pc-help,
  .pc-meta,
  .pc-note,
  .pc-foot {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .pc-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .pc-note {
    font-weight: 600;
  }
  .pc-foot {
    margin-top: auto;
    padding-top: 0.25rem;
  }
  .pc-sha,
  .pc-cmds {
    margin: 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--edge);
    border-radius: var(--r-md);
    background: #0f0a07;
    color: #f6ead9;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    list-style: none;
    min-width: 0;
  }
  .pc-sha__row + .pc-sha__row {
    margin-top: 0.55rem;
  }
  .pc-sha__label {
    display: block;
    color: #b8a48e;
    overflow-wrap: anywhere;
  }
  .pc-sha__hash,
  .pc-cmds code {
    display: block;
    background: none;
    color: inherit;
    font: inherit;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .pc-cmds li + li {
    margin-top: 0.4rem;
  }
  @keyframes pc-pulse {
    50% {
      opacity: 0.45;
    }
  }
  @keyframes pc-glow {
    50% {
      box-shadow:
        0 0 0 1px var(--accent),
        0 0 52px var(--glow);
    }
  }
  [data-motion='off'] .pc-card[data-yours],
  [data-motion='off'] .pc-status .pc-dot {
    animation: none;
  }
</style>
