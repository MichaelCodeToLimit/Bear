---
import type { AppInfo } from '@bear/core'

interface Props {
  app: AppInfo
  href?: string
  float?: boolean
}
const { app, href, float = false } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag
  class:list={['tile', { float }]}
  href={href}
  style={`--tile-color:var(--app-${app.id})`}
  data-app={app.id}
>
  <span class="tile__name">{app.name}</span>
  <span class="tile__tagline">{app.tagline}</span>
  {!app.ready && <span class="badge">Coming soon</span>}
</Tag>
