---
import Bear from '../Bear.astro'
import WindowsDownload from '../WindowsDownload.astro'
import type { ReleaseInfo } from '../../lib/releases'
import { url } from '../../site.config'

interface Props {
  release: ReleaseInfo | null
}
const { release } = Astro.props
---

<section class="cta section" aria-labelledby="cta-title" data-reveal>
  <Bear size={96} mood="wave" />
  <h2 id="cta-title" class="display cta__title">
    Bring your files. <span class="grad">Leave the subscription.</span>
  </h2>
  <div class="cta__actions">
    <WindowsDownload release={release} />
    <a class="btn btn--ghost" href={url('tour/')}>Take the tour</a>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cta__title {
    max-width: 16ch;
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
