---
import { APPS } from '@bear/core'
import favicon from '../../../desktop/build/icon-64.png'
import { appColorCss } from '../lib/appColors'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import '../styles/tokens.css'
import '../styles/base.css'

interface Props {
  title: string
  description?: string
  calm?: boolean
}
const { title, description = 'Bear: a cozy, open-source office suite for your desktop.', calm = false } = Astro.props
const fullTitle = title === 'Bear' ? title : `${title} | Bear`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <!-- Runs before first paint. Duplicates resolveMotion() in src/lib/motionPref.ts (saved wins, else system reduced-motion); keep the two in sync. -->
    <script is:inline>
      document.documentElement.classList.add('js')
      var saved = null
      try {
        saved = localStorage.getItem('bear-motion')
      } catch (e) {}
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      document.documentElement.dataset.motion =
        saved === 'on' || saved === 'off' ? saved : reduced ? 'off' : 'on'
      // Applies a saved Theme mixer mix. Defensive mirror of parseSavedMix() in
      // src/lib/themeMixer.ts (clamp ranges, ignore anything invalid); keep in sync.
      try {
        var mix = JSON.parse(localStorage.getItem('bear-mix'))
        if (mix && typeof mix === 'object' && !Array.isArray(mix)) {
          var clamp = function (v, lo, hi, d) {
            return typeof v === 'number' && isFinite(v) ? Math.min(hi, Math.max(lo, v)) : d
          }
          var rs = document.documentElement.style
          rs.setProperty('--hue-shift', clamp(mix.hue, -180, 180, 0) + 'deg')
          rs.setProperty('--round', String(clamp(mix.round, 0, 2, 1)))
          rs.setProperty('--motion-speed', String(clamp(mix.speed, 0.25, 2, 1)))
        }
      } catch (e) {}
    </script>
    <style set:html={appColorCss(APPS)} />
  </head>
  <body data-calm={calm ? '' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '../scripts/reveal'
      initReveal()
    </script>
  </body>
</html>
