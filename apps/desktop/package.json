{
  "name": "@bear/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Bear: a free, open-source desktop productivity suite",
  "author": "Bear contributors",
  "homepage": "https://github.com/MichaelCodeToLimit/Bear",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.config.cjs",
    "build:linux:main": "electron-vite build && electron-builder --linux AppImage deb rpm tar.gz --config electron-builder.config.cjs",
    "build:linux:flatpak": "electron-vite build && electron-builder --linux flatpak --config electron-builder.config.cjs",
    "build:dir": "electron-vite build && electron-builder --dir --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "@bear/app-board": "workspace:*",
    "@bear/app-mail": "workspace:*",
    "@bear/app-notes": "workspace:*",
    "@bear/app-photo": "workspace:*",
    "@bear/app-sheets": "workspace:*",
    "@bear/app-sites": "workspace:*",
    "@bear/app-slides": "workspace:*",
    "@bear/app-tasks": "workspace:*",
    "@bear/app-write": "workspace:*",
    "@bear/core": "workspace:*",
    "@bear/ui": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "imapflow": "^2.4.2",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.9.39",
    "nodemailer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
